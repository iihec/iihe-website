{# Floating "message admissions" button (desktop), sticky action bar (mobile), and the shared contact panel. #}
{% set c = site.contact %}
<div class="msg-panel" id="msg-panel" role="dialog" aria-modal="false" aria-labelledby="msg-title" hidden>
  <div class="msg-head">
    <p id="msg-title" class="msg-title">Message admissions</p>
    <button class="msg-close js-message-close" type="button" aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.8"/></svg>
    </button>
  </div>
  <p class="msg-sub">Ask about programmes, fees or the next intake. We reply in Khmer or English.</p>
  <ul class="msg-options">
    <li>
      {% if c.telegram %}<a class="msg-option" href="{{ c.telegram }}" target="_blank" rel="noopener">{% else %}<span class="msg-option is-pending">{% endif %}
        <span class="msg-icon msg-telegram" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M21.4 3.6 2.9 10.8c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.4l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8L22.8 5c.3-1.3-.5-1.9-1.4-1.4ZM9.7 14.1l8.7-5.5c.4-.3.8-.1.5.2l-7.3 6.6-.3 3.1-1.6-4.4Z"/></svg></span>
        <span class="msg-label">Telegram<small>{% if c.telegram %}Chat with admissions{% else %}Link coming soon{% endif %}</small></span>
      {% if c.telegram %}</a>{% else %}</span>{% endif %}
    </li>
    <li>
      {% if c.messenger %}<a class="msg-option" href="{{ c.messenger }}" target="_blank" rel="noopener">{% else %}<span class="msg-option is-pending">{% endif %}
        <span class="msg-icon msg-messenger" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2C6.4 2 2 6.1 2 11.6c0 2.9 1.2 5.4 3.1 7.1V22l3-1.7c.9.3 1.9.4 2.9.4 5.6 0 10-4.1 10-9.6S17.6 2 12 2Zm1 12.9-2.6-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.4 5.8Z"/></svg></span>
        <span class="msg-label">Facebook Messenger<small>{% if c.messenger %}Chat with admissions{% else %}Link coming soon{% endif %}</small></span>
      {% if c.messenger %}</a>{% else %}</span>{% endif %}
    </li>
    <li>
      {% if c.phone %}<a class="msg-option" href="tel:{{ c.phone | replace(' ', '') }}">{% else %}<span class="msg-option is-pending">{% endif %}
        <span class="msg-icon msg-phone" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg></span>
        <span class="msg-label">Call admissions<small>{% if c.phone %}{{ c.phone }}{% else %}Number coming soon{% endif %}</small></span>
      {% if c.phone %}</a>{% else %}</span>{% endif %}
    </li>
  </ul>
  <a class="msg-book" href="/book-a-consultation/">Or book a free consultation →</a>
</div>

<button class="msg-fab js-message" type="button" aria-controls="msg-panel" aria-expanded="false">
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2Zm3 5v2h10V9H7Zm0 4v2h7v-2H7Z" transform="translate(-1 -1)"/></svg>
  <span>Message admissions</span>
</button>

<div class="mobile-actions" aria-label="Quick actions">
  <button class="btn btn-secondary js-message" type="button" aria-controls="msg-panel">Message admissions</button>
  <a class="btn btn-primary" href="/book-a-consultation/">Book a free consultation</a>
</div>
