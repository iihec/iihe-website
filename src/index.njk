      {% for post in collections.posts | byCategory("guide") | head(3) %}
        {% include "partials/post-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container split-narrow">
    <div>
      <p class="eyebrow">Frequently asked questions</p>
      <h2 class="h2" style="margin-bottom:20px">Questions students and parents ask us</h2>
      <p class="muted" style="margin-bottom:28px">If your question is not here, ask it directly. Admissions answers on Telegram and Messenger during office hours, and in full at a free consultation.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="#consultation">Book a free consultation</a>
        <button class="btn btn-secondary js-message" type="button">Message admissions</button>
      </div>
    </div>
    {% include "partials/faq.njk" %}
  </div>
</section>

<section class="section bg-soft" id="consultation">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Book a free consultation</p>
      <h2 class="h2">Know your best starting point before you apply</h2>
      <p class="lead">Meet our admissions team at the IIHE Cambodia campus or online. We will give you clear answers about your programme, entry level, fees and next intake. The consultation is free and there is no obligation to enrol.</p>
    </div>
    {% include "partials/consultation.njk" %}
  </div>
</section>
